# --- Email (Resend) ---
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=
# "From" address. Use a verified domain, or the Resend test sender below.
RESEND_FROM="Moonlight Cocktail Bar <onboarding@resend.dev>"

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://moonlight-cocktail-bar.vercel.app

