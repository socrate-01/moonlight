# --- Email (Resend) ---
# Clé créée sur https://resend.com/api-keys
RESEND_API_KEY=

# Expéditeur par défaut. Le domaine doit être vérifié chez Resend.
EMAIL_FROM="Moonlight Cocktail Bar <contact@moonlight-cocktailbar.ca>"

# Facultatif — adresse de réponse par défaut.
# N'exige aucune vérification : elle n'affirme pas l'identité de l'expéditeur.
# C'est la solution immédiate pour recevoir les réponses ailleurs.
EMAIL_REPLY_TO=""

# Facultatif — expéditeurs supplémentaires proposés au choix dans l'admin,
# séparés par des virgules ou des retours à la ligne.
# Figurer ici ne suffit pas : chaque domaine doit être vérifié chez Resend.
EMAIL_SENDERS=""

# Ancien nom, encore accepté par la route d'invitation.
# RESEND_FROM=""

# --- Site ---
# L'URL publique exacte : elle construit les liens de désabonnement.
# Volontairement SANS préfixe NEXT_PUBLIC_ — une variable préfixée est
# remplacée par sa valeur à la compilation, et un build fabriqué sur un poste
# de développement emporterait « localhost » jusqu'en production.
APP_URL="https://moonlight-cocktailbar.ca"

# Utilisé par les composants client uniquement.
NEXT_PUBLIC_SITE_URL=https://moonlight-cocktailbar.ca

# --- Admin ---
# Facultatif — restreint l'envoi de courriels à ces adresses, séparées par des
# virgules. Vide : tout compte Firebase authentifié du projet est admin, ce qui
# est le comportement actuel de l'écran de connexion.
ADMIN_EMAILS=""

# --- Firebase (surcharges facultatives ; les valeurs publiques sont déjà dans lib/firebase.ts) ---
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Stockage des images (Vercel Blob) ---
# Créé et lié par `vercel blob create-store`. Sert aux photos de la galerie
# et aux visuels de cocktails déposés depuis l'admin.
BLOB_READ_WRITE_TOKEN=""

# --- Paiement de l'acompte (Square) ---
# « production » ou « sandbox ». Une clé de production envoyée au bac à sable
# échoue avec un message peu parlant : ce champ doit correspondre à la clé.
SQUARE_ENVIRONMENT="production"
SQUARE_ACCESS_TOKEN=""
SQUARE_APPLICATION_ID=""
SQUARE_LOCATION_ID=""
# Signe les notifications de paiement. Sans elle, le webhook refuse tout —
# c'est ce qui empêche de déclarer un paiement qui n'a pas eu lieu.
SQUARE_WEBHOOK_SIGNATURE_KEY=""
# Facultatif — version de l'API Square (défaut : 2025-01-23).
# SQUARE_API_VERSION=""
